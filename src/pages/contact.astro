---
import Layout from '../layouts/Layout.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { BRAND } from '../data/siteData';

const title = '預約與聯絡 | JSt.*頭皮養護中心';
const desc = '預約 JSt.*頭皮養護中心 Scalp Care Art Center，可透過 Facebook 私訊、電話或線上表單。新竹市專業頭皮養護空間，採全預約制。';
---

<Layout title={title} description={desc} ogImage="/images/ambiance-1.jpg">
  <div class="bg-gradient-to-br from-ivory to-cream pt-32 pb-16 text-center border-b border-sage-light">
    <div class="container-main">
      <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">預約與聯絡</h1>
      <p class="text-lg text-text-secondary max-w-xl mx-auto">我們期待為您服務，給頭皮一場溫柔的保養體驗</p>
    </div>
  </div>

  <!-- Contact Methods -->
  <section class="py-20 bg-cream">
    <div class="container-main">
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Messenger -->
        <div class="bg-white rounded-card p-8 shadow-card text-center animate-on-scroll">
          <div class="w-14 h-14 rounded-full bg-[#1877F2] text-white flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-text-primary mb-2">Facebook 私訊預約</h3>
          <p class="text-sm text-text-secondary mb-5 leading-relaxed">透過粉絲專頁私訊，即可線上諮詢與預約</p>
          <a href={BRAND.social.messenger} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-[#1877F2] text-white rounded-pill px-6 py-2.5 font-medium hover:bg-[#1464c0] transition-colors">
            私訊粉絲專頁
          </a>
        </div>
        <!-- Phone -->
        <div class="bg-white rounded-card p-8 shadow-card text-center animate-on-scroll delay-1">
          <div class="w-14 h-14 rounded-full bg-sage text-white flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-text-primary mb-2">電話諮詢</h3>
          <p class="text-sm text-text-secondary mb-5 leading-relaxed">直接來電，由專人為您服務與建議</p>
          <div class="text-3xl font-bold text-sage-dark mb-5">{BRAND.phone}</div>
          <a href={`tel:${BRAND.phoneClean}`} class="inline-flex items-center border-[1.5px] border-sage text-sage rounded-pill px-6 py-2.5 font-medium hover:bg-sage hover:text-white transition-all">
            撥打電話
          </a>
        </div>

        <!-- Form -->
        <div class="bg-white rounded-card p-8 shadow-card text-center animate-on-scroll delay-2">
          <div class="w-14 h-14 rounded-full bg-wood text-white flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-text-primary mb-2">線上表單預約</h3>
          <p class="text-sm text-text-secondary mb-5 leading-relaxed">填寫表單，我們將於 24 小時內與您確認</p>
          <button type="button" id="scrollToBooking" class="inline-flex items-center bg-sage text-white rounded-pill px-6 py-2.5 font-medium hover:bg-sage-dark transition-colors">
            填寫預約表單
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Info + Map -->
  <section class="py-16 bg-ivory">
    <div class="container-main">
      <div class="grid md:grid-cols-2 gap-12">
        <div class="animate-on-scroll">
          <h2 class="text-2xl font-bold text-text-primary mb-6">店家資訊</h2>
          <div class="space-y-4">
            <p class="flex items-start gap-3">
              <svg class="w-5 h-5 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              <span class="text-text-secondary">{BRAND.name}</span>
            </p>
            <p class="flex items-start gap-3">
              <svg class="w-5 h-5 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="text-text-secondary">{BRAND.address}<br /><span class="text-sm">停車：{BRAND.parking}</span></span>
            </p>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <div class="text-text-secondary text-sm space-y-1">
                <p>週一至週五 11:30 - 20:30</p>
                <p>週六 09:30 - 17:30</p>
                <p>週日 公休</p>
              </div>
            </div>
            <p class="flex items-center gap-3">
              <svg class="w-5 h-5 text-sage flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <a href={`tel:${BRAND.phoneClean}`} class="text-text-secondary hover:text-sage transition-colors">{BRAND.phone}</a>
            </p>
            <p class="flex items-center gap-3">
              <svg class="w-5 h-5 text-sage flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <a href={`tel:${BRAND.mobileClean}`} class="text-text-secondary hover:text-sage transition-colors">{BRAND.mobile}（手機）</a>
            </p>
            <div class="flex items-start gap-3 pt-2">
              <svg class="w-5 h-5 text-sage mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <p class="text-sm text-text-secondary">採全預約制，建議提前 3-5 天預約</p>
            </div>
          </div>
        </div>
        <div class="animate-on-scroll delay-2">
          <iframe src="https://www.google.com/maps?q=%E6%96%B0%E7%AB%B9%E5%B8%82%E6%9D%B1%E5%8D%80%E6%B0%91%E6%97%8F%E8%B7%AF158-3%E8%99%9F&amp;z=17&amp;output=embed" class="w-full h-full min-h-[300px] rounded-card border border-sage-light/50" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen title="JSt.*頭皮養護中心 位置地圖"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Booking Form -->
  <section id="booking-form" class="py-20 bg-cream">
    <div class="container-main max-w-2xl">
      <div class="bg-white rounded-card shadow-card p-8 md:p-10">
        <h2 class="text-2xl font-bold text-text-primary mb-2 text-center">線上預約表單</h2>
        <p class="text-text-secondary text-sm text-center mb-8">填寫以下資訊，我們將盡快與您確認預約</p>
        
        <form id="bookingForm" class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-text-primary mb-1">姓名 <span class="text-red-500">*</span></label>
              <input type="text" name="name" required class="w-full px-4 py-3 border-[1.5px] border-sage-light rounded-[10px] bg-white text-text-primary focus:border-sage focus:ring-2 focus:ring-sage/15 outline-none transition-colors" />
            </div>
            <div>
              <label class="block text-sm font-medium text-text-primary mb-1">電話 <span class="text-red-500">*</span></label>
              <input type="tel" name="phone" required class="w-full px-4 py-3 border-[1.5px] border-sage-light rounded-[10px] bg-white text-text-primary focus:border-sage focus:ring-2 focus:ring-sage/15 outline-none transition-colors" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-text-primary mb-1">電子郵件</label>
            <input type="email" name="email" class="w-full px-4 py-3 border-[1.5px] border-sage-light rounded-[10px] bg-white text-text-primary focus:border-sage focus:ring-2 focus:ring-sage/15 outline-none transition-colors" />
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-text-primary mb-1">預約項目</label>
              <select name="service" class="w-full px-4 py-3 border-[1.5px] border-sage-light rounded-[10px] bg-white text-text-primary focus:border-sage outline-none appearance-none" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%2212%22 viewBox=%220 0 12 12%22%3E%3Cpath fill=%22%236B6B6B%22 d=%22M6 8L1 3h10z%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:right 1rem center;">
                <option>想先諮詢</option>
                <option>頭皮檢測</option>
                <option>深層清潔</option>
                <option>頭皮SPA</option>
                <option>頭皮養護</option>
                <option>困擾護理</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-text-primary mb-1">期望日期</label>
              <input type="date" name="date" class="w-full px-4 py-3 border-[1.5px] border-sage-light rounded-[10px] bg-white text-text-primary focus:border-sage outline-none" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-text-primary mb-1">期望時段</label>
            <select name="time" class="w-full px-4 py-3 border-[1.5px] border-sage-light rounded-[10px] bg-white text-text-primary focus:border-sage outline-none appearance-none" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%2212%22 viewBox=%220 0 12 12%22%3E%3Cpath fill=%22%236B6B6B%22 d=%22M6 8L1 3h10z%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:right 1rem center;">
              <option>09:30 - 11:30（僅週六）</option>
              <option>11:30 - 14:00</option>
              <option>14:00 - 17:00</option>
              <option>17:00 - 20:30（週六至 17:30）</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-text-primary mb-1">備註</label>
            <textarea name="note" rows="3" class="w-full px-4 py-3 border-[1.5px] border-sage-light rounded-[10px] bg-white text-text-primary focus:border-sage focus:ring-2 focus:ring-sage/15 outline-none transition-colors resize-y"></textarea>
          </div>
          <div class="flex items-start gap-2">
            <input type="checkbox" name="agree" required class="mt-1 accent-sage" />
            <label class="text-xs text-text-secondary leading-relaxed">我同意 JSt.*頭皮養護中心蒐集並使用我的個人資料，僅用於預約與諮詢服務。</label>
          </div>
          <button type="submit" class="w-full bg-sage text-white rounded-pill py-3.5 font-medium hover:bg-sage-dark hover:-translate-y-0.5 transition-all shadow-cta">
            送出預約
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    var scrollButton = document.getElementById('scrollToBooking');
    var bookingSection = document.getElementById('booking-form');
    if (scrollButton && bookingSection) {
      var target = bookingSection;
      scrollButton.addEventListener('click', function () {
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      });
    }

    var bookingForm = document.getElementById('bookingForm');
    if (bookingForm) {
      bookingForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var form = e.currentTarget as HTMLFormElement;
        var name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
        var phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
        if (!name || !phone) {
          alert('請填寫姓名與電話');
          return;
        }
        alert('感謝您的預約！我們將於 24 小時內與您聯繫確認。');
        form.reset();
      });
    }
  </script>

  <!-- Mini CTA -->
  <section class="py-16 text-center bg-gradient-to-br from-sage-light to-ivory">
    <div class="container-main animate-on-scroll">
      <h2 class="text-2xl font-bold text-text-primary mb-2">期待在 JST 與您相遇</h2>
      <p class="text-text-secondary">有任何問題，歡迎隨時聯絡我們</p>
    </div>
  </section>

  <FloatingContact />
</Layout>
